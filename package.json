{
    "name": "BrowserQuest",
    "repository": {
        "type": "git",
        "url": "https://github.com/browserquest/BrowserQuest.git"
    },
    "version": "0.0.1",
    "private": false,
    "dependencies": {
        "@capacitor/android": "^6.0.0",
        "@capacitor/cli": "^6.0.0",
        "@capacitor/core": "^6.0.0",
        "@capacitor/haptics": "^6.0.0",
        "better-sqlite3": "^13.0.3",
        "compression": "^1.8.2",
        "concurrently": "^10.0.6",
        "express": "^4.19.0",
        "localtunnel": "^2.0.2",
        "log": "^1.4.0",
        "underscore": "^1.13.0",
        "ws": "^8.17.0"
    },
    "optionalDependencies": {
